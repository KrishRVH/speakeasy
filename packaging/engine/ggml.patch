diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4aac509..71c9753 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -240,6 +240,7 @@ option(GGML_METAL                           "ggml: use Metal"
 option(GGML_METAL_NDEBUG                    "ggml: disable Metal debugging"                   OFF)
 option(GGML_METAL_SHADER_DEBUG              "ggml: compile Metal with -fno-fast-math"         OFF)
 option(GGML_METAL_EMBED_LIBRARY             "ggml: embed Metal library"                       ${GGML_METAL})
+option(GGML_METAL_EMBED_COMPILED            "ggml: also embed a compiled Metal library"       OFF)
 set   (GGML_METAL_MACOSX_VERSION_MIN "" CACHE STRING
                                             "ggml: metal minimum macOS version")
 set   (GGML_METAL_STD "" CACHE STRING       "ggml: metal standard version (-std flag)")
diff --git a/src/ggml-metal/CMakeLists.txt b/src/ggml-metal/CMakeLists.txt
index 42054d8..2ea90a3 100644
--- a/src/ggml-metal/CMakeLists.txt
+++ b/src/ggml-metal/CMakeLists.txt
@@ -55,6 +55,34 @@ if (GGML_METAL_EMBED_LIBRARY)
         VERBATIM
     )
 
+    if (GGML_METAL_EMBED_COMPILED)
+        # A compiled library for devices without the tensor API, embedded beside the source so
+        # loading skips the runtime Metal compiler. Devices that need other macros compile source.
+        if (NOT GGML_METAL_MACOSX_VERSION_MIN)
+            message(FATAL_ERROR "GGML_METAL_EMBED_COMPILED requires GGML_METAL_MACOSX_VERSION_MIN")
+        endif()
+        set(METALLIB_COMPILED     "${CMAKE_CURRENT_BINARY_DIR}/autogenerated/ggml-metal-embed.metallib")
+        set(METALLIB_COMPILED_ASM "${CMAKE_CURRENT_BINARY_DIR}/autogenerated/ggml-metal-embed-compiled.s")
+        add_custom_command(
+            OUTPUT "${METALLIB_COMPILED_ASM}"
+            COMMAND xcrun -sdk macosx metal -O3 -std=metal3.1 -mmacosx-version-min=${GGML_METAL_MACOSX_VERSION_MIN}
+                    -DGGML_METAL_EMBED_LIBRARY=1 -DGGML_METAL_HAS_BF16=1
+                    -c "${METALLIB_SOURCE_EMBED}" -o "${METALLIB_COMPILED}.air"
+            COMMAND xcrun -sdk macosx metallib "${METALLIB_COMPILED}.air" -o "${METALLIB_COMPILED}"
+            COMMAND echo ".section __DATA,__ggml_mtlbin"           >  "${METALLIB_COMPILED_ASM}"
+            COMMAND echo ".globl _ggml_metallib_compiled_start"          >> "${METALLIB_COMPILED_ASM}"
+            COMMAND echo "_ggml_metallib_compiled_start:"                >> "${METALLIB_COMPILED_ASM}"
+            COMMAND echo .incbin "\"${METALLIB_COMPILED}\""            >> "${METALLIB_COMPILED_ASM}"
+            COMMAND echo ".globl _ggml_metallib_compiled_end"            >> "${METALLIB_COMPILED_ASM}"
+            COMMAND echo "_ggml_metallib_compiled_end:"                  >> "${METALLIB_COMPILED_ASM}"
+            DEPENDS "${METALLIB_EMBED_ASM}"
+            COMMENT "Compile and embed the Metal library"
+            VERBATIM
+        )
+        add_compile_definitions(GGML_METAL_EMBED_COMPILED)
+        target_sources(ggml-metal PRIVATE "${METALLIB_COMPILED_ASM}")
+    endif()
+
     target_sources(ggml-metal PRIVATE "${METALLIB_EMBED_ASM}")
 else()
     # copy metal files to bin directory
diff --git a/src/ggml-metal/ggml-metal-device.m b/src/ggml-metal/ggml-metal-device.m
index 780dfe8..b51a39b 100644
--- a/src/ggml-metal/ggml-metal-device.m
+++ b/src/ggml-metal/ggml-metal-device.m
@@ -208,6 +208,27 @@ ggml_metal_library_t ggml_metal_library_init(ggml_metal_device_t dev) {
         }
 #endif
 
+#if GGML_METAL_EMBED_COMPILED
+        // The compiled library matches the source built with GGML_METAL_HAS_BF16 and without the
+        // tensor API; other devices, or a library this OS cannot load, compile the source instead.
+        if (!library && ggml_metal_device_get_props(dev)->has_bfloat &&
+            !ggml_metal_device_get_props(dev)->has_tensor && getenv("GGML_METAL_COMPILE_SOURCE") == NULL) {
+            extern const char ggml_metallib_compiled_start[];
+            extern const char ggml_metallib_compiled_end[];
+            dispatch_data_t compiled = dispatch_data_create(
+                ggml_metallib_compiled_start, ggml_metallib_compiled_end - ggml_metallib_compiled_start,
+                NULL, DISPATCH_DATA_DESTRUCTOR_DEFAULT);
+            library = [device newLibraryWithData:compiled error:&error];
+            if (error) {
+                GGML_LOG_WARN("%s: compiled library rejected, compiling source: %s\n", __func__, [[error description] UTF8String]);
+                library = nil;
+                error = nil;
+            } else {
+                GGML_LOG_INFO("%s: using embedded compiled metal library\n", __func__);
+            }
+        }
+#endif
+
         if (!library) {
             @autoreleasepool {
                 // dictionary of preprocessor macros
