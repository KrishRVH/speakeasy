diff --git a/src/ggml-metal/CMakeLists.txt b/src/ggml-metal/CMakeLists.txt
index 42054d8..2ea90a3 100644
--- a/src/ggml-metal/CMakeLists.txt
+++ b/src/ggml-metal/CMakeLists.txt
@@ -55,6 +55,34 @@ if (GGML_METAL_EMBED_LIBRARY)
         VERBATIM
     )
 
+    if (GGML_METAL_EMBED_COMPILED)
+        # A compiled library for devices without the tensor API, embedded beside the source so
+        # loading skips the runtime Metal compiler. Devices that need other macros compile source.
+        if (NOT GGML_METAL_MACOSX_VERSION_MIN)
+            message(FATAL_ERROR "GGML_METAL_EMBED_COMPILED requires GGML_METAL_MACOSX_VERSION_MIN")
+        endif()
+        set(METALLIB_COMPILED     "${CMAKE_CURRENT_BINARY_DIR}/autogenerated/ggml-metal-embed.metallib")
+        set(METALLIB_COMPILED_ASM "${CMAKE_CURRENT_BINARY_DIR}/autogenerated/ggml-metal-embed-compiled.s")
+        add_custom_command(
+            OUTPUT "${METALLIB_COMPILED_ASM}"
+            COMMAND xcrun -sdk macosx metal -O3 -std=metal3.1 -mmacosx-version-min=${GGML_METAL_MACOSX_VERSION_MIN}
+                    -DGGML_METAL_EMBED_LIBRARY=1 -DGGML_METAL_HAS_BF16=1
+                    -c "${METALLIB_SOURCE_EMBED}" -o "${METALLIB_COMPILED}.air"
+            COMMAND xcrun -sdk macosx metallib "${METALLIB_COMPILED}.air" -o "${METALLIB_COMPILED}"
+            COMMAND echo ".section __DATA,__ggml_mtlbin"           >  "${METALLIB_COMPILED_ASM}"
+            COMMAND echo ".globl _ggml_metallib_compiled_start"          >> "${METALLIB_COMPILED_ASM}"
+            COMMAND echo "_ggml_metallib_compiled_start:"                >> "${METALLIB_COMPILED_ASM}"
+            COMMAND echo .incbin "\"${METALLIB_COMPILED}\""            >> "${METALLIB_COMPILED_ASM}"
+            COMMAND echo ".globl _ggml_metallib_compiled_end"            >> "${METALLIB_COMPILED_ASM}"
+            COMMAND echo "_ggml_metallib_compiled_end:"                  >> "${METALLIB_COMPILED_ASM}"
+            DEPENDS "${METALLIB_EMBED_ASM}"
+            COMMENT "Compile and embed the Metal library"
+            VERBATIM
+        )
+        add_compile_definitions(GGML_METAL_EMBED_COMPILED)
+        target_sources(ggml-metal PRIVATE "${METALLIB_COMPILED_ASM}")
+    endif()
+
     target_sources(ggml-metal PRIVATE "${METALLIB_EMBED_ASM}")
 else()
     # copy metal files to bin directory
diff --git a/src/ggml-metal/ggml-metal-context.m b/src/ggml-metal/ggml-metal-context.m
index 32d97cd..d9a0c9f 100644
--- a/src/ggml-metal/ggml-metal-context.m
+++ b/src/ggml-metal/ggml-metal-context.m
@@ -239,7 +239,13 @@ const char * ggml_metal_get_name(ggml_metal_t ctx) {
 void ggml_metal_synchronize(ggml_metal_t ctx) {
     // wait for any backend operations to finish
     if (ctx->cmd_buf_last) {
-        [ctx->cmd_buf_last waitUntilCompleted];
+        // Polling instead of sleeping keeps this thread running, and with it the CPU cluster's clock
+        // up, while the GPU works: the CPU steps that follow a graph otherwise run on cores that
+        // clocked down during the wait, which after an idle gap costs more than the GPU's own ramp.
+        // WFE idles the core between checks, at well under half a busy spin's energy.
+        while ([ctx->cmd_buf_last status] < MTLCommandBufferStatusCompleted) {
+            __asm__ __volatile__("wfe");
+        }
         ctx->cmd_buf_last = nil;
     }
 
