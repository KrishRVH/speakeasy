+            phases[lane] = exact_phase_table_
+                               ? static_cast<size_t>(remainder / rate_gcd_)
+                               : static_cast<size_t>(
+                                     remainder * static_cast<uint64_t>(phase_count_) /
+                                     static_cast<uint64_t>(output_rate_));
+            remainder += static_cast<uint64_t>(input_rate_);
+            source += remainder / static_cast<uint64_t>(output_rate_);
+            remainder %= static_cast<uint64_t>(output_rate_);
+        }
+        if (interior) {
+            const float* x[kLanes];
+            const float* c[kLanes];
+            double sum[kLanes] = {0.0, 0.0, 0.0, 0.0};
+            for (size_t lane = 0; lane < kLanes; ++lane) {
+                x[lane] = input_.data() +
+                          static_cast<size_t>(sources[lane] + 1 - kHalfTaps - input_start_);
+                c[lane] = coefficients_.data() + phases[lane] * kTaps;
+            }
+            for (size_t tap = 0; tap < kTaps; ++tap)
+                for (size_t lane = 0; lane < kLanes; ++lane)
+                    sum[lane] += static_cast<double>(x[lane][tap]) * c[lane][tap];
+            for (size_t lane = 0; lane < kLanes; ++lane)
+                output->push_back(static_cast<float>(sum[lane]));
+            next_output_ += kLanes;
+            source_index_ = source;
+            source_remainder_ = remainder;
+            continue;
+        }
+        if (!ready(source_index_, next_output_))
             break;
         output->push_back(filtered_sample(source_index_, phase_index()));
         ++next_output_;
