+ggml_runtime::TensorBag
+ConformerConv::build_channel_last(
+    ggml_runtime::Session* session, ggml_tensor* x_ct,
+    ggml_runtime::TensorContainer* session_tensor_container, ggml_backend_buffer_type_t buft) {
+    auto bf_ctx = session_tensor_container->get_ctx_of_buffer_type(buft);
+    ggml_context* ctx = bf_ctx.ctx;
+    const int64_t channels = d_model_;
+    const int64_t frames = x_ct->ne[1];
+    // GLU over channels: first half times the sigmoid of the second.
+    ggml_tensor* gate = ggml_sigmoid(
+        ctx, ggml_view_2d(ctx, x_ct, channels, frames, x_ct->nb[1], channels * x_ct->nb[0]));
+    ggml_tensor* glu =
+        ggml_mul(ctx, ggml_view_2d(ctx, x_ct, channels, frames, x_ct->nb[1], 0), gate);
+
+    // Same-length depthwise convolution with zero padding (K - 1) / 2 on each side. SSM_CONV is
+    // a one-kernel depthwise cross-correlation over time-inner input that returns [C, T].
+    const int pad = (kernel_size_ - 1) / 2;
+    ggml_tensor* by_time = ggml_cont(ctx, ggml_transpose(ctx, glu));  // [T, C]
+    ggml_tensor* padded = ggml_roll(ctx, ggml_pad(ctx, by_time, 2 * pad, 0, 0, 0), pad, 0, 0, 0);
+    ggml_tensor* conv = ggml_ssm_conv(
+        ctx, ggml_reshape_3d(ctx, padded, padded->ne[0], channels, 1),
+        session->model_tensor_container->get_tensor_by_name(name_ + ".folded_dw_taps").tensor);
+    ggml_tensor* normed = ggml_add(
+        ctx, ggml_reshape_2d(ctx, conv, channels, frames),
+        session->model_tensor_container->get_tensor_by_name(name_ + ".folded_dw_bias").tensor);
+    ggml_tensor* activated = ggml_silu(ctx, normed);
+
+    auto w2 =
+        session->model_tensor_container->get_tensor_by_name(name_ + ".pointwise_conv2.weight");
+    ggml_tensor* w2_mat = w2.tensor;
+    if (w2_mat->ne[0] == 1 && w2_mat->ne[2] > 1) {
+        w2_mat = ggml_reshape_2d(ctx, w2_mat, w2_mat->ne[1], w2_mat->ne[2]);
+    }
+    ggml_tensor* out = ggml_mul_mat(ctx, w2_mat, activated);
+    if (use_bias_) {
+        out = ggml_add_inplace(
+            ctx, out,
+            session->model_tensor_container
+                ->get_tensor_by_name(name_ + ".pointwise_conv2.bias")
+                .tensor);
+    }
+    ggml_runtime::TensorBag out_bag;
+    out_bag.add_tensor(ggml_runtime::ggml_bf_tensor(out, buft));
+    return out_bag;
 }
 
