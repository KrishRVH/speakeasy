+ggml_runtime::TensorBag
+SubSampling::build_channel_last(
+    ggml_runtime::Session* session, ggml_runtime::TensorBag input_tensors,
+    ggml_runtime::TensorContainer* session_tensor_container) {
+    // Activations are [C, F, T]: channel-inner, then frequency, then time. ggml's conv_2d and
+    // conv_2d_dw lower through F16 im2col, per-channel matrix-vector products, and transposes back
+    // to [F, T, C]; on Metal that costs about five times this formulation.
+    const int channels = cfg_.subsampling_conv_channels;
+    const int stages = static_cast<int>(std::log2(cfg_.subsampling_factor));
+    auto model_tensor = [&](int index, const char* part) {
+        return session->model_tensor_container
+            ->get_tensor_by_name(name_ + ".conv." + std::to_string(index) + part)
+            .tensor;
+    };
+    auto features = input_tensors.get_tensor(0);
+    auto* stem = model_tensor(0, ".weight");
+    auto bf_ctx = session_tensor_container->get_ctx_of_buffer_type(
+        session->model_tensor_container->get_tensor_by_name(name_ + ".conv.0.weight").buft);
+    ggml_context* ctx = bf_ctx.ctx;
+
+    // Stem: 3x3 stride-2 convolution from one channel, as im2col taps times the [9, C] kernel.
+    ggml_tensor* taps = ggml_im2col(ctx, stem, features.tensor, 2, 2, 1, 1, 1, 1, true, GGML_TYPE_F32);
+    ggml_tensor* y = ggml_mul_mat(
+        ctx, ggml_cast(ctx, ggml_reshape_2d(ctx, stem, 9, channels), GGML_TYPE_F32),
+        ggml_reshape_2d(ctx, taps, 9, taps->ne[1] * taps->ne[2]));
+    y = ggml_reshape_3d(ctx, y, channels, taps->ne[1], taps->ne[2]);
+    y = ggml_relu(ctx, ggml_add(ctx, y, ggml_reshape_1d(ctx, model_tensor(0, ".bias"), channels)));
+
+    int index = 2;  // after the stem's Conv2D and ReLU
+    for (int stage = 1; stage < stages; ++stage, index += 3) {
+        // Depthwise 3x3, stride 2, zero padding 1: nine strided views scaled per channel.
+        const int64_t out_f = (y->ne[1] - 1) / 2 + 1;
+        const int64_t out_t = (y->ne[2] - 1) / 2 + 1;
+        ggml_tensor* padded = ggml_roll(ctx, ggml_pad(ctx, y, 0, 2, 2, 0), 0, 1, 1, 0);
+        ggml_tensor* weights = ggml_cont(
+            ctx, ggml_transpose(
+                     ctx, ggml_cast(
+                              ctx, ggml_reshape_2d(ctx, model_tensor(index, ".weight"), 9, channels),
+                              GGML_TYPE_F32)));  // [C, 9]
+        ggml_tensor* sum = nullptr;
+        for (int kt = 0; kt < 3; ++kt) {
+            for (int kf = 0; kf < 3; ++kf) {
+                ggml_tensor* window = ggml_view_3d(
+                    ctx, padded, channels, out_f, out_t, 2 * padded->nb[1], 2 * padded->nb[2],
+                    kf * padded->nb[1] + kt * padded->nb[2]);
+                ggml_tensor* tap = ggml_view_1d(ctx, weights, channels, (kt * 3 + kf) * weights->nb[1]);
+                ggml_tensor* term = ggml_mul(ctx, window, tap);
+                sum = sum == nullptr ? term : ggml_add(ctx, sum, term);
+            }
+        }
+        y = ggml_add(ctx, sum, ggml_reshape_1d(ctx, model_tensor(index, ".bias"), channels));
+
+        // Pointwise 1x1: one [C, C] product over every position.
+        ggml_tensor* mixed = ggml_mul_mat(
+            ctx, ggml_reshape_2d(ctx, model_tensor(index + 1, ".weight"), channels, channels),
+            ggml_reshape_2d(ctx, y, channels, y->ne[1] * y->ne[2]));
+        y = ggml_reshape_3d(ctx, mixed, channels, y->ne[1], y->ne[2]);
+        y = ggml_relu(ctx, ggml_add(ctx, y, ggml_reshape_1d(ctx, model_tensor(index + 1, ".bias"), channels)));
+    }
+
+    // NeMo flattens (C, F) per frame with frequency fastest: [C, F, T] -> [F, C, T] -> [F*C, T].
+    ggml_tensor* frames = ggml_cont(ctx, ggml_permute(ctx, y, 1, 0, 2, 3));
+    frames = ggml_reshape_4d(ctx, frames, frames->ne[0] * frames->ne[1], frames->ne[2], 1, 1);
+    ggml_runtime::TensorBag output_tensors;
+    output_tensors.add_tensor(ggml_runtime::ggml_bf_tensor(frames, bf_ctx.buft));
+    return out_->build_graph(session, output_tensors, session_tensor_container);
+}
