# Copy to .env in Speakeasy's configuration directory. Do not commit your keys.
# Process environment values override this file. No variable interpolation or shell execution.
# Set transcription.provider explicitly to local, groq, or openai in settings.json.
# Simply adding a key never switches local transcription to the cloud.
OPENAI_API_KEY=
GROQ_API_KEY=

# Only sent to the configured loopback endpoint when cleanup.provider is local.
LOCAL_LLM_API_KEY=
