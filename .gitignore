# Ignore generated and local files only; lockfiles, fixtures, and shared editor config stay visible.

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor temporary files, not editor project config
*.swp
*.swo
*~
.#*

# Local environment and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Logs, task notes, and run output
*.log
*.tmp
*.temp
/.tmp/
/tmp/
/.scratch/
/artifacts/

# Tool output
node_modules/
/.cache/
/.gstack/
/.lycheecache
.basedpyright/
.coverage
.coverage.*
.hypothesis/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
__pycache__/
*.py[codz]
*.egg-info/
/target/
**/target/
**/*.rs.bk

# Native build output outside target/
*.dylib
*.o
*.so
*.dSYM/

# mise
mise.local.toml
mise.*.local.toml
.mise.local.toml
.mise.*.local.toml
mise.local.lock
mise.*.local.lock
.mise.local.lock
.mise.*.local.lock

# Speakeasy local files and native assets
/settings.json
/instance.lock
/instance.port
/tray-hint-seen
/models/
/tools/
