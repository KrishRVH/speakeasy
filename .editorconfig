root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

[*.{toml,json,jsonc,manifest,plist,yml}]
indent_size = 2

# A slash in a section glob anchors the whole pattern to this directory, so name AppRun bare.
[{*.sh,AppRun}]
indent_size = 2
switch_case_indent = true
space_redirects = true

[*.ps1]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false
