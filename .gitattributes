# Text is LF everywhere, except where a platform needs CRLF to run a script.
* text=auto eol=lf
*.ps1 text eol=crlf

*.md text diff=markdown
*.rs text diff=rust

# Binary assets
*.icns binary
*.ico binary
*.png binary
*.ttf binary
*.gz binary
*.tar binary
*.zip binary

# Speakeasy local files and native assets
*.bin binary
*.gguf binary
*.wav binary
