# Normalize repository text; Windows scripts retain native line endings.
* text=auto eol=lf
*.md text diff=markdown
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Native assets, local speech models, and release binaries are never text.
*.bin binary
*.dll binary
*.exe binary
*.gguf binary
*.icns binary
*.ico binary
*.png binary
*.ttf binary
*.wav binary
*.zip binary
